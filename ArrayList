package collections.com;
import java.util.ArrayList;
public class ArrayListCollections {
    public static void main(String[] args) {
        ArrayList al = new ArrayList();
        al.add(1);
        al.add(2);
        al.add(3);
        al.add(4);
        al.add("TAP");
        al.add(4.5);
        al.add(true);
        al.add("TAP");
        al.add(2,90);
        ArrayList al2 = new ArrayList();
        al2.add(10);
        al2.add(20);
        al2.add(30);
        al2.add(40);
        
        al.addAll(al2);
        System.out.println("Print all elements in al and al2: " + al);
        
        al.addAll(2,al2);
        System.out.println("Print al2 elements in index 2 position of al1: " + al);
      
        System.out.println("Is al2 is present in al1: " +al.retainAll(al2));
        
    }
}


